{
  "name": "mcdl-launcher-electron",
  "version": "0.3.2",
  "private": true,
  "description": "MCDL Launcher · Hollow Frame Electron UI",
  "author": {
    "name": "总多离别",
    "email": "noreply@mcdl.invalid"
  },
  "homepage": "https://github.com/jkoyli/mcdl-launcher",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron --no-stdio-init .",
    "start:local": "electron --no-stdio-init .",
    "dev": "electron --no-stdio-init . --dev",
    "start:troubleshoot": "electron --no-stdio-init --no-sandbox .",
    "dev:troubleshoot": "electron --no-stdio-init --no-sandbox . --dev",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:isolated": "node --test tests/*.test.js",
    "dist:dir": "electron-builder --dir",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "fetch:jre": "node scripts/fetch-jre.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
