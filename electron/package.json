{
  "name": "mcdl-launcher-electron",
  "version": "0.2.0",
  "private": true,
  "description": "MCDL Launcher · Hollow Frame Electron UI",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron --no-stdio-init .",
    "start:local": "electron --no-stdio-init .",
    "dev": "electron --no-stdio-init . --dev",
    "start:troubleshoot": "electron --no-stdio-init --no-sandbox .",
    "dev:troubleshoot": "electron --no-stdio-init --no-sandbox . --dev",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:isolated": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "45.2.1"
  }
}
